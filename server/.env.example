# Copy this file to ".env" and fill in your own values. NEVER commit the real .env.
PORT=4000

# MySQL connection (use your own MySQL user/password — this file is a template only)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=coonoor_club

# Long random string used to sign login tokens
JWT_SECRET=please-change-this-to-a-long-random-secret

# Default admin created by "npm run seed" (change the password after first login)
SEED_ADMIN_NAME=Club Administrator
SEED_ADMIN_EMAIL=admin@coonoorclub.com
SEED_ADMIN_PASSWORD=ChangeMe!123

# Where the React frontend runs (for CORS). Comma-separate multiple origins.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
